static func valid_kind(kind: int) -> int:
 return clampi(kind,0,COUNT-1)
static func get_character(kind: int) -> Dictionary:
 return DATA[valid_kind(kind)]
static func default_opponent(kind: int) -> int:
 return [1,0,0,0,0][valid_kind(kind)]
static func opponent_for(kind: int, requested: int = -1) -> int:
 var player:=valid_kind(kind)
 return default_opponent(player) if requested<0 or requested>=COUNT or requested==player else requested
