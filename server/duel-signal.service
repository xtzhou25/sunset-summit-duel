[Unit]
Description=sunset-summit-duel LAN signal server
After=network-online.target

[Service]
Type=simple
# 仓库路径固定，代码随 git 更新，重启即生效
WorkingDirectory=/home/deploy/build/sunset-summit-duel
Environment=SIGNAL_HOST=172.17.0.1
Environment=SIGNAL_PORT=8899
Environment=SIGNAL_GRACE_MS=60000
Environment=DUEL_DATA_DIR=/home/deploy/.duel-signal
Environment=NODE_PATH=/home/deploy/build/node_modules
ExecStart=/usr/bin/node /home/deploy/build/sunset-summit-duel/server/lan_signal_server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

# 安装（root，一次性）：
#   cp server/duel-signal.service /home/deploy/.config/systemd/user/
#   chown deploy:deploy /home/deploy/.config/systemd/user/duel-signal.service
#   loginctl enable-linger deploy
#   sudo -u deploy XDG_RUNTIME_DIR=/run/user/$(id -u deploy) systemctl --user daemon-reload
#   sudo -u deploy XDG_RUNTIME_DIR=/run/user/$(id -u deploy) systemctl --user enable --now duel-signal
# 之后 deploy 用户即可自行 systemctl --user restart duel-signal，无需 root。
